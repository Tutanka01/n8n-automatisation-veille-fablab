# Copié en .env par `make install` (scripts/bootstrap.sh), qui génère aussi les secrets vides.
# Ne jamais versionner le fichier .env.

# ─── LLM (n'importe quelle API compatible OpenAI : /v1/chat/completions) ───────
# L'URL de base et les modèles se règlent dans config/veille.json (section "llm").
# Ici, uniquement le secret. Laisser vide pour un LLM local sans clé (Ollama…).
LLM_API_KEY=

# ─── Accès ────────────────────────────────────────────────────────────────────
# Compte propriétaire n8n (appliqué à chaque démarrage : modifier ici puis `make up`)
N8N_OWNER_EMAIL=admin@fablab.local
N8N_OWNER_FIRSTNAME=Admin
N8N_OWNER_LASTNAME=FabLab
N8N_OWNER_PASSWORD=

# Interface de validation (http://localhost:5678/webhook/veille) : authentification HTTP Basic
VEILLE_UI_USER=fablab
VEILLE_UI_PASSWORD=

# ─── Secrets techniques (générés automatiquement si vides) ────────────────────
# ⚠ N8N_ENCRYPTION_KEY chiffre les identifiants stockés dans n8n : ne jamais la changer.
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
VEILLE_DB_PASSWORD=
N8N_RUNNERS_AUTH_TOKEN=

# ─── E-mail (optionnel) : envoi du récapitulatif après chaque lot ─────────────
# Activer aussi "notifications.email.actif" dans config/veille.json
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true pour SMTPS (port 465), false pour STARTTLS (port 587)
SMTP_SECURE=false

# ─── Proxy sortant (ex. réseau de l'université) ───────────────────────────────
# Vide = connexion directe. Renseigné = les requêtes HTTP(S) de n8n vers l'extérieur (HAL, RSS,
# LLM hébergé) passent par lui, ex. http://proxy.exemple.fr:3128
OUTBOUND_PROXY=
# Hôtes supplémentaires à joindre sans le proxy, séparés par des virgules. Inutile pour un hôte de
# config/veille.json à adresse interne (ex. LLM de l'établissement) : il est détecté au démarrage.
OUTBOUND_NO_PROXY=

# ─── Accès par le réseau : reverse proxy (optionnel) ──────────────────────────
# Sans lui, n8n n'est joignable que depuis cette machine. Avec COMPOSE_PROFILES=proxy, seule
# l'interface de validation (/webhook/veille) est exposée ; l'éditeur n8n reste sur 127.0.0.1.
COMPOSE_PROFILES=
# Nom de domaine de l'interface (seul, sans http:// ni port) : le proxy ne répond qu'à ce nom.
VEILLE_DOMAIN=
# true = HTTPS avec vos certificats (HTTP redirigé vers HTTPS) ; false = HTTP seul.
# Après un passage en true, les navigateurs imposent HTTPS pour ce domaine pendant 30 jours.
VEILLE_HTTPS=false
# Dossier des certificats et noms des fichiers PEM (chaîne complète + clé privée)
TLS_CERTS_DIR=./certs
TLS_CERT_FILE=fullchain.pem
TLS_KEY_FILE=privkey.pem
PROXY_BIND=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# ─── Sauvegarde quotidienne (dossier backups/) ────────────────────────────────
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# ─── Éditeur n8n (accès local) ────────────────────────────────────────────────
# 127.0.0.1 = accessible uniquement depuis cette machine (recommandé ; à distance : tunnel SSH).
N8N_BIND=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
# Mettre false si vous accédez à n8n en http:// depuis une autre machine que localhost
N8N_SECURE_COOKIE=true

TZ=Europe/Paris
N8N_VERSION=2.40.7
