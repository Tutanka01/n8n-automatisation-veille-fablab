# Copié en .env par `make install` (scripts/bootstrap.sh), qui génère aussi les secrets vides.
# Ne jamais versionner le fichier .env.

# ─── LLM (n'importe quelle API compatible OpenAI : /v1/chat/completions) ───────
# L'URL de base et les modèles se règlent dans config/veille.json (section "llm").
# Ici, uniquement le secret. Laisser vide pour un LLM local sans clé (Ollama…).
LLM_API_KEY=

# ─── Accès ────────────────────────────────────────────────────────────────────
# Compte propriétaire n8n (appliqué à chaque démarrage : modifier ici puis `make up`)
N8N_OWNER_EMAIL=admin@fablab.local
N8N_OWNER_FIRSTNAME=Admin
N8N_OWNER_LASTNAME=FabLab
N8N_OWNER_PASSWORD=

# Interface de validation (http://localhost:5678/webhook/veille) : authentification HTTP Basic
VEILLE_UI_USER=fablab
VEILLE_UI_PASSWORD=

# ─── Secrets techniques (générés automatiquement si vides) ────────────────────
# ⚠ N8N_ENCRYPTION_KEY chiffre les identifiants stockés dans n8n : ne jamais la changer.
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
VEILLE_DB_PASSWORD=
N8N_RUNNERS_AUTH_TOKEN=

# ─── E-mail (optionnel) : envoi du récapitulatif après chaque lot ─────────────
# Activer aussi "notifications.email.actif" dans config/veille.json
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true pour SMTPS (port 465), false pour STARTTLS (port 587)
SMTP_SECURE=false

# ─── Réseau ───────────────────────────────────────────────────────────────────
# 127.0.0.1 = accessible uniquement depuis cette machine (recommandé).
N8N_BIND=127.0.0.1
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
# Mettre false si vous accédez à n8n en http:// depuis une autre machine que localhost
N8N_SECURE_COOKIE=true

TZ=Europe/Paris
N8N_VERSION=2.40.7
