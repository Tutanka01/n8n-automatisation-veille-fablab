      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1840,
        120
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE publications SET status = 'error', last_error = left($2, 2000)\nWHERE id = $1 RETURNING id, status",
        "options": {
          "queryReplacement": "={{ [ $('Une par une').item.json.id, $json.error || 'Erreur inconnue' ] }}"
        }
      },
      "id": "ee88f2c0-e6c4-505e-a4f0-facac939e8c9",
      "name": "Marquer en échec",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2080,
        240
      ],
      "credentials": {
        "postgres": {
          "id": "VeilleCredPgDb01",
          "name": "Veille · Base PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Paramètres transmis au workflow « E-mail récapitulatif » en fin de lot.\nlet ids = [];\ntry { ids = $('Préparer les éléments').all().map(i => i.json.id).filter(Boolean); } catch (e) { /* lot vide */ }\nlet apresCollecte = false;\ntry { apresCollecte = $('Après la collecte').isExecuted; } catch (e) { /* autre déclencheur */ }\nreturn [{ json: { mode: 'lot', ids, apres_collecte: apresCollecte } }];\n"
      },
