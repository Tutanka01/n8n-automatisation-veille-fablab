      ]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "/home/node/.n8n-files/config/veille.json",
        "options": {}
      },
      "id": "d64c9cfd-c8c6-5cdb-b61b-67e633546c4d",
      "name": "Fichier de configuration",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        260,
        60
      ]
    },
    {
      "parameters": {
        "operation": "fromJson",
        "destinationKey": "config",
        "options": {}
      },
      "id": "519a91c4-26af-5fa3-a105-d9387ea8ba97",
      "name": "Lire la configuration",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        480,
        60
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Sans LLM configuré, on s'arrête AVANT de réserver le lot : les publications gardent leurs tentatives.\nconst { config } = $input.first().json;\nif (!String(config.llm?.base_url || '').trim() || !String(config.llm?.modele || '').trim()) {\n  throw new Error('LLM non configuré : renseignez « llm.base_url » et « llm.modele » dans config/veille.json, puis relancez la veille.');\n}\nreturn $input.all();\n"
      },
      "id": "3c84927b-db30-58a8-b460-3bc5bd38247f",
      "name": "Vérifier le LLM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        60
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH liberees AS (\n  UPDATE publications SET status = 'error', last_error = 'Traitement interrompu (délai dépassé)'\n  WHERE status = 'processing' AND updated_at < now() - interval '2 hours'\n  RETURNING id\n)\nSELECT count(*)::int AS liberees FROM liberees",
        "options": {}
      },
      "id": "3dccf9a3-69e2-5681-87a5-2c2d80b83488",
      "name": "Libérer les traitements interrompus",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        920,
        60
      ],
      "credentials": {
        "postgres": {
          "id": "VeilleCredPgDb01",
          "name": "Veille · Base PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH lot AS (\n  SELECT id FROM publications\n  WHERE status = 'new' OR (status = 'error' AND attempts < $1)\n  ORDER BY (status = 'new') DESC, deposited_at DESC NULLS LAST, id DESC\n  LIMIT $2\n  FOR UPDATE SKIP LOCKED\n)\nUPDATE publications p\nSET status = 'processing', attempts = p.attempts + 1, last_error = NULL,\n    processing_step = CASE WHEN p.linkedin IS NOT NULL THEN 'pdf' WHEN p.fiche IS NOT NULL THEN 'contenus' ELSE 'tri' END\nFROM lot WHERE p.id = lot.id\nRETURNING p.id, p.title",
        "options": {
          "queryReplacement": "={{ [ Number($('Lire la configuration').first().json.config.traitement?.max_tentatives) || 3, Number($('Lire la configuration').first().json.config.traitement?.taille_lot) || 10 ] }}"
        }
      },
      "id": "2abca9b1-ab82-5fcc-8f7e-e11d63c001e3",
      "name": "Réserver un lot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1140,
        60
      ],
      "credentials": {
        "postgres": {
          "id": "VeilleCredPgDb01",
          "name": "Veille · Base PostgreSQL"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "26f956b2-f46f-54f6-bbcf-56953c7f7f3c",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "58ced50e-a686-55f3-ba9c-eca68ef941f8",
      "name": "Quelque chose à traiter ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1140,
        240
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Chaque publication réservée part vers le sous-workflow avec la configuration du moment.\nconst config = $('Lire la configuration').first().json.config;\nreturn $input.all().map(item => ({ json: { id: item.json.id, title: item.json.title, config } }));\n"
      },
      "id": "4227c716-a375-511c-9d26-3df145f85e52",
      "name": "Préparer les éléments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        0
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "11ec0617-0825-5b13-8421-845769284750",
      "name": "Une par une",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1580,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "VeilleTraiterPub",
          "mode": "list",
          "cachedResultName": "Veille · 3 · Traiter une publication"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "d4f9d84e-7e26-57ed-a168-d09d86f0c804",
